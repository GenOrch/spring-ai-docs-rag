# ---------------------------------------------------------------------------
# Example environment file — copy to `.env` (gitignored) and fill in real
# values there. Never commit real API keys or database passwords.
#
# 下面列出所有可用环境变量及其默认值，与 docs/configuration.md 的「环境变量总表」一一对应。
# 复制成 `.env` 后按需修改；启动时由 spring.config.import 自动加载。
# ---------------------------------------------------------------------------

# === DashScope（阿里云百炼）—— chat / embedding / rerank 共用 ===
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI 兼容端点（DashScope compatible-mode）。通常无需改。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === 模型名 ===
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_RERANK_MODEL=gte-rerank-v2
# 重排走 DashScope 原生接口（不走 OpenAI 兼容端点）。
DASHSCOPE_RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# === RAG 链路 ===
# 首次启动设为 true 自动建索引；否则手动 POST /admin/ingest。
RAG_INGEST_ON_STARTUP=false
# 语料目录：版本化 AsciiDoc 快照在 data/raw/spring-ai/{version}。
RAG_DATA_DIR=./data
# 嵌入批量大小。DashScope text-embedding-v3 单请求上限 10，勿调大。
RAG_EMBED_BATCH_SIZE=10
# pgvector 向量表名。
RAG_TABLE_NAME=vector_store
# /admin 与 /mcp 远程调用所需 token；空=拒绝远程调用（loopback 始终放行）。
RAG_ADMIN_TOKEN=
# 单次 /ask SSE 流超时（毫秒）。
RAG_ASK_TIMEOUT_MS=120000
# 审计/链路日志环形缓冲大小 + 可选的落盘审计文件（供 rag_logs MCP 工具读取）。
RAG_MCP_AUDIT_BUFFER_SIZE=500
RAG_MCP_OPERATION_BUFFER_SIZE=1000
RAG_MCP_AUDIT_FILE_ENABLED=false
RAG_MCP_AUDIT_FILE=data/audit/requests.jsonl

# === PostgreSQL + pgvector（RDS）—— 向量库 ===
# 真实连接信息只进本地 .env，勿提交。
PGVECTOR_URL=jdbc:postgresql://localhost:5432/rag
PGVECTOR_USER=rag
PGVECTOR_PASSWORD=rag

# === 可观测 ===
# OTel 追踪导出端点（Jaeger）。
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
